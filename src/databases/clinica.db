-- Funciones
CREATE OR REPLACE FUNCTION clinica.crear_paciente(
    _id_doctor INT,
    _nombre VARCHAR,
    _telefono_principal VARCHAR,
    _apellido_paterno VARCHAR DEFAULT NULL,
    _apellido_materno VARCHAR DEFAULT NULL,
    _fecha_nacimiento DATE DEFAULT NULL,
    _sexo CHAR DEFAULT NULL,
    _correo_electronico VARCHAR DEFAULT NULL,
    _telefono_secundario VARCHAR DEFAULT NULL,
    _calle VARCHAR DEFAULT NULL,
    _numero_exterior VARCHAR DEFAULT NULL,
    _numero_interior VARCHAR DEFAULT NULL,
    _colonia VARCHAR DEFAULT NULL,
    _ciudad VARCHAR DEFAULT NULL,
    _estado VARCHAR DEFAULT NULL,
    _codigo_postal VARCHAR DEFAULT NULL,
    _pais VARCHAR DEFAULT 'México',
    _contacto_emergencia_nombre VARCHAR DEFAULT NULL,
    _contacto_emergencia_parentesco VARCHAR DEFAULT NULL,
    _contacto_emergencia_telefono VARCHAR DEFAULT NULL,
    _ocupacion VARCHAR DEFAULT NULL,
    _referido_por VARCHAR DEFAULT NULL
)
RETURNS INT AS $$
DECLARE
    nuevo_id INT;
BEGIN
    INSERT INTO clinica."tPaciente" (
        id_doctor, nombre, apellido_paterno, apellido_materno,
        fecha_nacimiento, sexo, telefono_principal, correo_electronico,
        telefono_secundario, calle, numero_exterior, numero_interior,
        colonia, ciudad, estado, codigo_postal, pais,
        contacto_emergencia_nombre, contacto_emergencia_parentesco,
        contacto_emergencia_telefono, ocupacion, referido_por
    ) VALUES (
        _id_doctor, _nombre, _apellido_paterno, _apellido_materno,
        _fecha_nacimiento, _sexo, _telefono_principal, _correo_electronico,
        _telefono_secundario, _calle, _numero_exterior, _numero_interior,
        _colonia, _ciudad, _estado, _codigo_postal, _pais,
        _contacto_emergencia_nombre, _contacto_emergencia_parentesco,
        _contacto_emergencia_telefono, _ocupacion, _referido_por
    )
    RETURNING id_paciente INTO nuevo_id;
    
    INSERT INTO clinica."tHistoriaMedica" (id_paciente) VALUES (nuevo_id);
    INSERT INTO clinica."tHistoriaDental" (id_paciente) VALUES (nuevo_id);
    
    RETURN nuevo_id;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;


CREATE OR REPLACE FUNCTION clinica.obtener_expediente(_id_paciente INT)
RETURNS JSON AS $$
DECLARE
    resultado JSON;
BEGIN
    SELECT json_build_object(
        'paciente', row_to_json(p),
        'historia_medica', row_to_json(hm),
        'historia_dental', row_to_json(hd),
        'ultimas_citas', (SELECT json_agg(row_to_json(c)) FROM clinica."tCita" c WHERE c.id_paciente = _id_paciente ORDER BY c.fecha_hora_inicio DESC LIMIT 10),
        'ultimos_tratamientos', (SELECT json_agg(row_to_json(tr)) FROM clinica."tTratamientoRealizado" tr WHERE tr.id_paciente = _id_paciente ORDER BY tr.fecha_tratamiento DESC LIMIT 20),
        'odontograma', (SELECT json_agg(row_to_json(o)) FROM clinica."tOdontograma" o WHERE o.id_paciente = _id_paciente)
    )
    INTO resultado
    FROM clinica."tPaciente" p
    LEFT JOIN clinica."tHistoriaMedica" hm ON p.id_paciente = hm.id_paciente
    LEFT JOIN clinica."tHistoriaDental" hd ON p.id_paciente = hd.id_paciente
    WHERE p.id_paciente = _id_paciente;
    
    RETURN resultado;
END;
$$ LANGUAGE plpgsql STABLE;


CREATE OR REPLACE FUNCTION clinica.validar_cita_horario()
RETURNS TRIGGER AS $$
DECLARE
    v_duracion INT;
    v_inicio TIME;
    v_fin TIME;
    v_dia SMALLINT;
    v_valido BOOLEAN;
BEGIN
    -- Obtener duración del tratamiento si está asociado, si no usar intervalo de la cita
    IF NEW.id_tratamiento IS NOT NULL THEN
        SELECT duracion_minutos INTO v_duracion
        FROM clinica."tTratamiento"
        WHERE id_tratamiento = NEW.id_tratamiento
          AND id_doctor = NEW.id_doctor;
        IF v_duracion IS NULL THEN
            v_duracion := EXTRACT(EPOCH FROM (NEW.fecha_hora_fin - NEW.fecha_hora_inicio)) / 60;
        END IF;
    ELSE
        v_duracion := EXTRACT(EPOCH FROM (NEW.fecha_hora_fin - NEW.fecha_hora_inicio)) / 60;
    END IF;

    v_inicio := NEW.fecha_hora_inicio::TIME;
    v_fin := NEW.fecha_hora_fin::TIME;
    v_dia := EXTRACT(DOW FROM NEW.fecha_hora_inicio); -- 0=Dom..6=Sáb

    -- 1. Verificar que la cita caiga dentro de un bloque laboral (respetando margen de fin)
    SELECT TRUE INTO v_valido
    FROM clinica."tHorarioDoctor"
    WHERE id_doctor = NEW.id_doctor
      AND dia_semana = v_dia
      AND activo = TRUE
      AND hora_inicio <= v_inicio
      AND (hora_fin - (margen_fin_minutos || ' minutes')::INTERVAL) >= v_fin
    LIMIT 1;

    IF v_valido IS NULL THEN
        RAISE EXCEPTION 'La cita está fuera del horario laboral del doctor o no respeta el margen.';
    END IF;

    -- 2. Verificar que el doctor no tenga otra cita activa que se solape
    IF EXISTS (
        SELECT 1
        FROM clinica."tCita"
        WHERE id_doctor = NEW.id_doctor
          AND id_cita IS DISTINCT FROM NEW.id_cita
          AND estado IN ('programada', 'confirmada', 'en_curso')   -- Solo estas bloquean disponibilidad
          AND tsrange(fecha_hora_inicio, fecha_hora_fin, '[)') &&
              tsrange(NEW.fecha_hora_inicio, NEW.fecha_hora_fin, '[)')
    ) THEN
        RAISE EXCEPTION 'El doctor ya tiene una cita en ese horario.';
    END IF;

    -- Verificar que el paciente no tenga otra cita activa al mismo tiempo.
    IF EXISTS (
        SELECT 1
        FROM clinica."tCita"
        WHERE id_paciente = NEW.id_paciente
          AND id_cita IS DISTINCT FROM NEW.id_cita
          AND estado IN ('programada', 'confirmada', 'en_curso')
          AND tsrange(fecha_hora_inicio, fecha_hora_fin, '[)') &&
              tsrange(NEW.fecha_hora_inicio, NEW.fecha_hora_fin, '[)')
    ) THEN
        RAISE EXCEPTION 'El paciente ya tiene otra cita en ese horario.';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION clinica.horarios_libres(
    _id_doctor INT,
    _fecha DATE,
    _duracion_minutos INT
)
RETURNS TABLE (inicio TIME, fin TIME) AS $$
BEGIN
    RETURN QUERY
    WITH bloques AS (
        SELECT hora_inicio, (hora_fin - (margen_fin_minutos || ' minutes')::INTERVAL)::TIME AS hora_fin
        FROM clinica."tHorarioDoctor"
        WHERE id_doctor = _id_doctor
          AND dia_semana = EXTRACT(DOW FROM _fecha)
          AND activo = TRUE
    ),
    citas_ordenadas AS (
        SELECT fecha_hora_inicio::TIME AS ini, fecha_hora_fin::TIME AS fin
        FROM clinica."tCita"
        WHERE id_doctor = _id_doctor
          AND fecha_hora_inicio::DATE = _fecha
          AND estado NOT IN ('cancelada', 'no_asistio')
        ORDER BY ini
    ),
    huecos AS (
        SELECT b.hora_inicio AS hueco_inicio,
               COALESCE(
                   (SELECT c.ini
                    FROM citas_ordenadas c
                    WHERE c.ini >= b.hora_inicio AND c.ini < b.hora_fin
                    ORDER BY c.ini LIMIT 1),
                   b.hora_fin
               ) AS hueco_fin
        FROM bloques b
        UNION ALL
        SELECT c.fin AS hueco_inicio,
               COALESCE(
                   (SELECT c2.ini
                    FROM citas_ordenadas c2
                    WHERE c2.ini > c.fin AND c2.ini <= b.hora_fin
                    ORDER BY c2.ini LIMIT 1),
                   b.hora_fin
               ) AS hueco_fin
        FROM bloques b
        JOIN citas_ordenadas c ON c.ini >= b.hora_inicio AND c.ini < b.hora_fin
    )
    SELECT hueco_inicio, hueco_fin
    FROM huecos
    WHERE hueco_fin - hueco_inicio >= (_duracion_minutos || ' minutes')::INTERVAL
    ORDER BY hueco_inicio;
END;
$$ LANGUAGE plpgsql STABLE;


CREATE OR REPLACE FUNCTION clinica.crear_cita_con_paciente(
    p_id_doctor INT,
    p_fecha_hora_inicio TIMESTAMP,
    p_fecha_hora_fin TIMESTAMP,
    p_id_tratamiento INT DEFAULT NULL,
    p_estado VARCHAR DEFAULT 'programada',
    p_tipo_cita VARCHAR DEFAULT NULL,
    p_notas TEXT DEFAULT NULL,
    p_color VARCHAR DEFAULT NULL,
    p_id_paciente INT DEFAULT NULL,
    p_nombre_nuevo VARCHAR DEFAULT NULL,
    p_telefono_principal_nuevo VARCHAR DEFAULT NULL,
    p_correo_nuevo VARCHAR DEFAULT NULL
)
RETURNS TABLE (id_cita INT, id_paciente INT) AS $$
DECLARE
    v_id_paciente INT;
    v_id_cita INT;
BEGIN
    IF p_id_paciente IS NULL THEN
        IF p_nombre_nuevo IS NULL OR p_telefono_principal_nuevo IS NULL THEN
            RAISE EXCEPTION 'Debe proporcionar un id_paciente o al menos nombre y teléfono para un nuevo paciente.';
        END IF;

        v_id_paciente := clinica.crear_paciente(
            p_id_doctor,
            p_nombre_nuevo,
            p_telefono_principal_nuevo,
            _correo_electronico := p_correo_nuevo
        );
    ELSE
        SELECT pac.id_paciente INTO v_id_paciente
        FROM clinica."tPaciente" pac
        WHERE pac.id_paciente = p_id_paciente AND pac.id_doctor = p_id_doctor;

        IF v_id_paciente IS NULL THEN
            RAISE EXCEPTION 'Paciente inexistente o no pertenece a este doctor.';
        END IF;
    END IF;

    INSERT INTO clinica."tCita" (
        id_paciente, id_doctor, id_tratamiento,
        fecha_hora_inicio, fecha_hora_fin,
        estado, tipo_cita, notas, color
    ) VALUES (
        v_id_paciente, p_id_doctor, p_id_tratamiento,
        p_fecha_hora_inicio, p_fecha_hora_fin,
        p_estado, p_tipo_cita, p_notas, p_color
    )
    RETURNING clinica."tCita".id_cita INTO v_id_cita;

    RETURN QUERY SELECT v_id_cita, v_id_paciente;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;


-- Triggers
CREATE TRIGGER trg_validar_cita
BEFORE INSERT OR UPDATE ON clinica."tCita"
FOR EACH ROW EXECUTE FUNCTION clinica.validar_cita_horario();

-- Permisos
GRANT USAGE ON SCHEMA clinica TO anon, authenticated, service_role;
GRANT ALL ON ALL TABLES IN SCHEMA clinica TO anon, authenticated, service_role;
ALTER DEFAULT PRIVILEGES IN SCHEMA clinica GRANT ALL ON TABLES TO anon, authenticated, service_role;